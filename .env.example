# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=True

# Paths
DOWNLOAD_DIR=./downloads
TEMP_DIR=./temp

# Download Settings
MAX_CONCURRENT_DOWNLOADS=3
DEFAULT_FORMAT=mp3
DEFAULT_QUALITY=320

# Metadata
EMBED_METADATA=True
DOWNLOAD_ARTWORK=True
DOWNLOAD_LYRICS=True

# Folder Organization
FOLDER_TEMPLATE={artist}/{album}/{track_number} - {title}

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/nexamusic.log
